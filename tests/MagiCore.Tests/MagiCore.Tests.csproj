<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);NU1605</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" Version="10.1.0" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.16.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <ProjectReference Include="..\..\src\MagiCore\MagiCore.csproj" />
    <ProjectReference Include="..\..\samples\McpServer\McpServer.csproj" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers" Version="4.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <Compile Remove="Transports\MemoryMcpServerTests.cs" />
    <Compile Remove="Integration\AgentFrameworkContextProviderTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Update="testsettings.example.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="testsettings.local.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
