<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>MagiCore</PackageId>
    <AssemblyName>MagiCore</AssemblyName>
    <RootNamespace>MagiCore</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>MagiCore contributors</Authors>
    <Description>Long-term memory for AI applications in .NET with semantic search and replaceable embedding and storage providers.</Description>
    <PackageTags>ai;memory;agents;rag;semantic-search</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/jihadkhawaja/magicore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="icon.png" />
    <None Include="..\..\assets\readme-header.svg" Pack="true" PackagePath="assets/readme-header.svg" />
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="LICENSE" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" Version="10.1.0" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.11" />
    <PackageReference Include="System.Net.Http.Json" Version="10.0.11" />
    <PackageReference Include="System.Text.Json" Version="10.0.11" />
  </ItemGroup>
</Project>
